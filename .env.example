# Copiar a .env para desarrollo local. En Railway se setean como variables del servicio.

# --- Entorno ---
# "development" (default) o "production". En "production" el arranque falla si
# SECRET_KEY o CORS_ORIGINS no están bien configurados, y no se permite sembrar
# la BD con contraseñas semilla débiles.
APP_ENV=development

# --- Base de datos ---
# Local: postgresql://localhost/waritradingfoods  (o dejar sin setear para usar SQLite)
# Railway: referenciar el Postgres del proyecto -> ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://localhost/waritradingfoods

# --- Seguridad ---
# Clave para firmar los JWT. OBLIGATORIO en producción (mín. 32 caracteres). Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- CORS ---
# Dominios del frontend permitidos, separados por coma, sin barra final.
# Debe incluir el valor de NEXT_PUBLIC_SITE_URL del frontend. OBLIGATORIO en producción.
# En desarrollo (APP_ENV != production) localhost / ngrok / *.up.railway.app se
# permiten siempre por regex; en producción ese regex se desactiva.
CORS_ORIGINS=https://waritradingfoods.com,https://www.waritradingfoods.com

# --- Usuarios semilla ---
# Contraseñas de las 3 cuentas demo (admin / productor / comprador).
# Solo se usan al sembrar una BD vacía. En producción son OBLIGATORIAS y no
# pueden ser triviales (admin123, changeme, etc.). En local, si se dejan vacías
# se usan los defaults de desarrollo (ver CREDENCIALES.local.md).
SEED_ADMIN_PASSWORD=
SEED_PRODUCTOR_PASSWORD=
SEED_COMPRADOR_PASSWORD=
