# Copiar a .env para desarrollo local. En Railway se setean como variables del servicio.

# --- Base de datos ---
# Local: postgresql://localhost/hallpayaku  (o dejar sin setear para usar SQLite)
# Railway: referenciar el Postgres del proyecto -> ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://localhost/hallpayaku

# --- Seguridad ---
# Clave para firmar los JWT. OBLIGATORIO en producción. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- CORS ---
# Dominios del frontend permitidos, separados por coma, sin barra final.
# Debe incluir el valor de NEXT_PUBLIC_SITE_URL del frontend.
# localhost / ngrok / *.up.railway.app se permiten siempre (no hace falta listarlos).
CORS_ORIGINS=https://waritradingfoods.com,https://www.waritradingfoods.com

# --- Usuarios semilla ---
# Contraseñas de las 3 cuentas demo (admin / productor / comprador).
# En producción poner valores reales; se hashean con bcrypt al sembrar la BD.
SEED_ADMIN_PASSWORD=
SEED_PRODUCTOR_PASSWORD=
SEED_COMPRADOR_PASSWORD=
